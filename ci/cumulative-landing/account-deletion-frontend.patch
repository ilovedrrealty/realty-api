diff --git a/apps/dashboard/src/api/accountDeletion.ts b/apps/dashboard/src/api/accountDeletion.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cc907005698b9022d19554b20c673c081cd1cad
--- /dev/null
+++ b/apps/dashboard/src/api/accountDeletion.ts
@@ -0,0 +1,218 @@
+import client from './axios'
+
+export const DELETION_STATUSES = [
+  'pending_review', 'reviewed', 'retention_hold', 'cancelled',
+] as const
+export type DeletionStatus = typeof DELETION_STATUSES[number]
+export interface DeletionRequest {
+  request_id: string | null
+  status: DeletionStatus | 'none'
+  requested_at: string | null
+  review_after: null
+  version: number
+  reviewed_at: string | null
+  review_reason: string | null
+}
+export interface AdminDeletionRequest extends DeletionRequest {
+  user_id: string
+  email: string
+  display_name: string
+}
+export interface DeletionPage {
+  items: AdminDeletionRequest[]
+  total: number
+}
+type Failure = 'invalid' | 'stale' | 'forbidden' | 'unavailable' | 'unconfirmed'
+export class AccountDeletionError extends Error {
+  constructor(public code: Failure) {
+    super(code)
+    this.name = 'AccountDeletionError'
+  }
+}
+const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i
+const validVersion = (value: unknown): value is number =>
+  Number.isSafeInteger(value) && (value as number) >= 0
+const dateOrNull = (value: unknown): value is string | null =>
+  value === null || (typeof value === 'string' && Number.isFinite(Date.parse(value)))
+
+function record(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('Invalid deletion state')
+  }
+  return value as Record<string, unknown>
+}
+
+function parseRequest(value: unknown): DeletionRequest {
+  const row = record(value)
+  if (
+    !(row.status === 'none' || DELETION_STATUSES.includes(row.status as DeletionStatus)) ||
+    !validVersion(row.version) || row.review_after !== null ||
+    !dateOrNull(row.requested_at) || !dateOrNull(row.reviewed_at) ||
+    !(row.review_reason === null || (
+      typeof row.review_reason === 'string' && row.review_reason.length <= 1000
+    ))
+  ) {
+    throw new Error('Invalid deletion state')
+  }
+  if (row.status === 'none') {
+    if (
+      row.request_id !== null || row.version !== 0 || row.requested_at !== null ||
+      row.reviewed_at !== null || row.review_reason !== null
+    ) {
+      throw new Error('Invalid deletion state')
+    }
+  } else if (
+    typeof row.request_id !== 'string' || !uuid.test(row.request_id) ||
+    row.version < 1 || row.requested_at === null
+  ) {
+    throw new Error('Invalid deletion state')
+  }
+  return {
+    request_id: row.request_id as string | null,
+    status: row.status as DeletionRequest['status'],
+    version: row.version,
+    requested_at: row.requested_at,
+    review_after: null,
+    reviewed_at: row.reviewed_at,
+    review_reason: row.review_reason as string | null,
+  }
+}
+
+function failure(error: unknown, mutation: boolean): AccountDeletionError {
+  if (error instanceof AccountDeletionError) return error
+  const status = (error as { response?: { status?: number } })?.response?.status
+  if (status === 409 || status === 404) return new AccountDeletionError('stale')
+  if (status === 403) return new AccountDeletionError('forbidden')
+  if (status === 422 || status === 400) return new AccountDeletionError('invalid')
+  return new AccountDeletionError(mutation ? 'unconfirmed' : 'unavailable')
+}
+
+function requireVersion(id: string, version: number) {
+  if (!uuid.test(id) || !validVersion(version) || version < 1) {
+    throw new AccountDeletionError('invalid')
+  }
+}
+
+export async function getAccountDeletionRequest(signal?: AbortSignal): Promise<DeletionRequest> {
+  try {
+    return parseRequest((await client.get('/auth/me/delete-request', { signal })).data)
+  } catch (error) {
+    throw failure(error, false)
+  }
+}
+
+export async function requestAccountDeletion(email: string): Promise<DeletionRequest> {
+  if (!email.trim() || email.trim().length > 320) {
+    throw new AccountDeletionError('invalid')
+  }
+  try {
+    const response = await client.post('/auth/me/delete-request', {
+      confirm_email: email.trim(),
+      confirm_request: true,
+    })
+    const state = parseRequest(response.data)
+    if (state.status === 'none' || state.status === 'cancelled') {
+      throw new Error('Request not confirmed')
+    }
+    return state
+  } catch (error) {
+    throw failure(error, true)
+  }
+}
+
+export async function cancelAccountDeletion(id: string, version: number): Promise<DeletionRequest> {
+  requireVersion(id, version)
+  try {
+    const response = await client.post('/auth/me/delete-request/cancel', {
+      request_id: id,
+      expected_version: version,
+    })
+    const state = parseRequest(response.data)
+    if (state.request_id !== id || state.status !== 'cancelled' || state.version < version) {
+      throw new Error('Cancellation not confirmed')
+    }
+    return state
+  } catch (error) {
+    throw failure(error, true)
+  }
+}
+
+export async function getAccountDeletionQueue(
+  status: DeletionStatus | undefined,
+  offset = 0,
+  signal?: AbortSignal,
+): Promise<DeletionPage> {
+  if (
+    (status !== undefined && !DELETION_STATUSES.includes(status)) ||
+    !Number.isSafeInteger(offset) || offset < 0
+  ) {
+    throw new AccountDeletionError('invalid')
+  }
+  try {
+    const response = await client.get('/admin/account-deletion-requests', {
+      params: { ...(status ? { status } : {}), limit: 50, offset },
+      signal,
+    })
+    const row = record(response.data)
+    if (
+      !Array.isArray(row.items) || row.items.length > 50 ||
+      !Number.isSafeInteger(row.total) || (row.total as number) < row.items.length
+    ) {
+      throw new Error('Invalid deletion queue')
+    }
+    const items = row.items.map(value => {
+      const item = record(value)
+      const state = parseRequest(item)
+      if (
+        state.status === 'none' || typeof item.user_id !== 'string' ||
+        !uuid.test(item.user_id) || typeof item.email !== 'string' ||
+        !item.email || typeof item.display_name !== 'string'
+      ) {
+        throw new Error('Invalid deletion queue')
+      }
+      return {
+        ...state, user_id: item.user_id, email: item.email, display_name: item.display_name,
+      }
+    })
+    if (new Set(items.map(item => item.request_id)).size !== items.length) {
+      throw new Error('Duplicate deletion request')
+    }
+    return { items, total: row.total as number }
+  } catch (error) {
+    throw failure(error, false)
+  }
+}
+
+export async function reviewAccountDeletion(
+  id: string,
+  version: number,
+  status: 'reviewed' | 'retention_hold',
+  reason: string,
+): Promise<DeletionRequest> {
+  requireVersion(id, version)
+  const cleanReason = reason.trim()
+  if (
+    !['reviewed', 'retention_hold'].includes(status) ||
+    !cleanReason || cleanReason.length > 1000
+  ) {
+    throw new AccountDeletionError('invalid')
+  }
+  try {
+    const response = await client.post(
+      `/admin/account-deletion-requests/${encodeURIComponent(id)}/review`,
+      { expected_version: version, status, reason: cleanReason },
+    )
+    const state = parseRequest(response.data)
+    // Matching same-Admin replays return the persisted version unchanged.
+    if (
+      state.request_id !== id || state.status !== status ||
+      state.review_reason !== cleanReason || state.reviewed_at === null ||
+      state.version < version
+    ) {
+      throw new Error('Review not confirmed')
+    }
+    return state
+  } catch (error) {
+    throw failure(error, true)
+  }
+}
