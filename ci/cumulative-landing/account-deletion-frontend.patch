diff --git a/tests/account-deletion.test.cjs b/tests/account-deletion.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..70d1b0e898eaeb9056d3f20fb54a74399541cf24
--- /dev/null
+++ b/tests/account-deletion.test.cjs
@@ -0,0 +1,270 @@
+// Actual TS/TSX with synthetic API/hooks only. No accounts, production data,
+// messages, deletion, network, dependency installation, or local app build.
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const path = require('node:path')
+const vm = require('node:vm')
+const ts = require('typescript')
+const React = require('react')
+const runtime = require('react/jsx-runtime')
+const { renderToStaticMarkup } = require('react-dom/server')
+const root = path.resolve(__dirname, '../apps/dashboard/src')
+const clone = value => JSON.parse(JSON.stringify(value))
+const ID = '10000000-0000-4000-8000-000000000001'
+const USER = '20000000-0000-4000-8000-000000000002'
+const EMAIL = 'synthetic@example.invalid'
+const TIME = '2026-11-17T12:00:00Z'
+const state = changes => ({ request_id: ID, status: 'pending_review', requested_at: TIME, review_after: null, version: 1, reviewed_at: null, review_reason: null, ...changes })
+const none = () => state({ request_id: null, status: 'none', requested_at: null, version: 0 })
+const row = changes => ({ ...state(), user_id: USER, display_name: 'Synthetic member', email: EMAIL, ...changes })
+function compiled(file) {
+  const result = ts.transpileModule(fs.readFileSync(path.join(root, file), 'utf8'), { compilerOptions: { target: ts.ScriptTarget.ES2020, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.ReactJSX, esModuleInterop: true }, reportDiagnostics: true })
+  assert.deepEqual(result.diagnostics, [])
+  return result.outputText
+}
+function apiFixture(response, error) {
+  const calls = [], module = { exports: {} }
+  const client = Object.fromEntries(['get', 'post'].map(method => [method, async (...args) => { calls.push({ method, args }); if (error) throw error; return { data: typeof response === 'function' ? response(method, ...args) : response } }]))
+  vm.runInNewContext(compiled('api/accountDeletion.ts'), { module, exports: module.exports, require: name => { assert.equal(name, './axios'); return { __esModule: true, default: client } } })
+  return { ...module.exports, calls }
+}
+
+test('own API reads persisted state and sends explicit confirmation and versioned cancellation only', async () => {
+  const api = apiFixture((method, url) => method === 'post' && url.endsWith('/cancel') ? state({ status: 'cancelled', version: 2 }) : state())
+  const signal = new AbortController().signal
+  assert.equal((await api.getAccountDeletionRequest(signal)).status, 'pending_review')
+  assert.equal(api.calls[0].args[1].signal, signal)
+  await api.requestAccountDeletion(' ' + EMAIL + ' ')
+  await api.cancelAccountDeletion(ID, 1)
+  assert.deepEqual(clone(api.calls), [
+    { method: 'get', args: ['/auth/me/delete-request', { signal: {} }] },
+    { method: 'post', args: ['/auth/me/delete-request', { confirm_email: EMAIL, confirm_request: true }] },
+    { method: 'post', args: ['/auth/me/delete-request/cancel', { request_id: ID, expected_version: 1 }] },
+  ])
+})
+
+test('Admin API uses bounded status pages and trimmed user-visible versioned review reasons', async () => {
+  const api = apiFixture((method) => method === 'get' ? { items: [row()], total: 70 } : state({ status: 'retention_hold', version: 2, reviewed_at: TIME, review_reason: 'Synthetic explanation' }))
+  const signal = new AbortController().signal
+  assert.equal((await api.getAccountDeletionQueue('pending_review', 50, signal)).total, 70)
+  assert.equal(api.calls[0].args[1].signal, signal)
+  assert.deepEqual(clone(api.calls[0].args[1].params), { status: 'pending_review', limit: 50, offset: 50 })
+  await api.getAccountDeletionQueue(undefined)
+  assert.deepEqual(clone(api.calls[1].args[1].params), { limit: 50, offset: 0 })
+  await api.reviewAccountDeletion(ID, 1, 'retention_hold', '  Synthetic explanation  ')
+  assert.deepEqual(clone(api.calls[2]), { method: 'post', args: [`/admin/account-deletion-requests/${ID}/review`, { expected_version: 1, status: 'retention_hold', reason: 'Synthetic explanation' }] })
+})
+
+test('invalid actions and malformed persisted states never become a fake successful or empty state', async () => {
