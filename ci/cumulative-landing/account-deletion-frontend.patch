diff --git a/apps/dashboard/src/pages/admin/AccountDeletion.tsx b/apps/dashboard/src/pages/admin/AccountDeletion.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..26ae85db5b2f06952c89284185ffbb59a3cc7865
--- /dev/null
+++ b/apps/dashboard/src/pages/admin/AccountDeletion.tsx
@@ -0,0 +1,273 @@
+import { useEffect, useId, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import {
+  AccountDeletionError,
+  DELETION_STATUSES,
+  getAccountDeletionQueue,
+  reviewAccountDeletion,
+  type AdminDeletionRequest,
+  type DeletionPage,
+  type DeletionStatus,
+} from '../../api/accountDeletion'
+
+const input = 'w-full min-w-0 rounded-lg border border-line bg-white px-3 py-2 text-sm text-ink disabled:opacity-50'
+const button = 'rounded-lg border border-line bg-white px-4 py-2 text-sm font-semibold disabled:cursor-not-allowed disabled:opacity-50'
+
+export function AdminAccountDeletion({ userRole }: { userRole: string }) {
+  const { t } = useTranslation('account_deletion')
+  if (userRole !== 'admin') return <p role="alert">{t('admin.denied')}</p>
+  return <ReviewQueue />
+}
+
+function ReviewQueue() {
+  const { t, i18n } = useTranslation('account_deletion')
+  const id = useId()
+  const [filter, setFilter] = useState<DeletionStatus | 'active'>('pending_review')
+  const [offset, setOffset] = useState(0)
+  const [refresh, setRefresh] = useState(0)
+  const [page, setPage] = useState<DeletionPage | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState('')
+  const [selected, setSelected] = useState<AdminDeletionRequest | null>(null)
+  const [status, setStatus] = useState<'reviewed' | 'retention_hold'>('reviewed')
+  const [reason, setReason] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [mustReload, setMustReload] = useState(false)
+  const mutation = useRef(false)
+  const reviewHeading = useRef<HTMLHeadingElement>(null)
+
+  useEffect(() => {
+    if (selected) reviewHeading.current?.focus()
+  }, [selected?.request_id])
+
+  useEffect(() => {
+    const controller = new AbortController()
+    setLoading(true)
+    setPage(null)
+    setError('')
+    setSelected(null)
+    setReason('')
+    getAccountDeletionQueue(filter === 'active' ? undefined : filter, offset, controller.signal)
+      .then(next => {
+        if (!controller.signal.aborted) {
+          setPage(next)
+          setMustReload(false)
+        }
+      })
+      .catch(failure => {
+        if (!controller.signal.aborted) {
+          const denied = failure instanceof AccountDeletionError && failure.code === 'forbidden'
+          setError(denied ? 'admin.denied' : 'load_error')
+        }
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setLoading(false)
+      })
+    return () => controller.abort()
+  }, [filter, offset, refresh])
+
+  function choose(row: AdminDeletionRequest) {
+    setSelected(row)
+    setReason('')
+    setStatus('reviewed')
+    setError('')
+  }
+
+  async function save() {
+    if (!selected?.request_id || selected.status === 'cancelled') return
+    if (!reason.trim() || reason.trim().length > 1000) return
+    if (mutation.current || loading || mustReload) return
+
+    mutation.current = true
+    setBusy(true)
+    setError('')
+    try {
+      await reviewAccountDeletion(selected.request_id, selected.version, status, reason)
+      setSelected(null)
+      setReason('')
+      setRefresh(value => value + 1)
+    } catch (failure) {
+      const code = failure instanceof AccountDeletionError ? failure.code : 'unconfirmed'
+      if (code === 'invalid') setError('invalid')
+      else if (code === 'stale') setError('stale')
+      else if (code === 'forbidden') setError('admin.denied')
+      else setError('unconfirmed')
+      setMustReload(true)
+    } finally {
+      mutation.current = false
+      setBusy(false)
+    }
+  }
+
+  function date(value: string | null) {
+    if (!value) return '—'
+    return new Date(value).toLocaleString(
+      i18n.language.startsWith('es') ? 'es-DO' : 'en-US',
+    )
+  }
+
+  return (
+    <section className="min-w-0 space-y-5" aria-labelledby={`${id}-title`}>
+      <div>
+        <h2 id={`${id}-title`} className="text-xl font-bold text-ink">{t('admin.title')}</h2>
+        <p className="mt-2 max-w-3xl text-sm leading-relaxed text-ink2">{t('admin.intro')}</p>
+      </div>
+      <div className="flex flex-col items-start gap-3 sm:flex-row sm:items-end">
+        <div className="w-full min-w-0 sm:w-auto sm:max-w-md">
+          <label htmlFor={`${id}-filter`} className="mb-1 block text-sm font-semibold">
+            {t('admin.filter')}
+          </label>
+          <select
+            id={`${id}-filter`}
+            className={input}
+            value={filter}
+            disabled={busy}
+            onChange={event => {
+              setFilter(event.target.value as typeof filter)
+              setOffset(0)
+            }}
+          >
+            <option value="active">{t('admin.active')}</option>
+            {DELETION_STATUSES.map(value => (
+              <option key={value} value={value}>{t(`statuses.${value}`)}</option>
+            ))}
+          </select>
+        </div>
+        <button
+          type="button"
+          className={button}
+          disabled={loading || busy}
+          onClick={() => setRefresh(value => value + 1)}
+        >
+          {t('refresh')}
+        </button>
+      </div>
+      {loading ? <p role="status">{t('loading')}</p> : null}
+      {error ? (
+        <p role="alert" className="text-sm font-semibold text-red-800">{t(error)}</p>
+      ) : null}
+      {!loading && page ? (
+        <>
+          <p className="text-sm text-ink2">{t('admin.total', { count: page.total })}</p>
+          {page.items.length === 0 ? (
+            <p>{t('admin.empty')}</p>
+          ) : (
+            <ul className="space-y-3">
+              {page.items.map(row => (
+                <li key={row.request_id} className="min-w-0 rounded-xl border border-line bg-white p-4">
+                  <div className="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
+                    <div className="min-w-0 text-sm">
+                      <p className="break-words font-semibold">{row.display_name || row.email}</p>
+                      <p className="break-all text-ink2">{row.email}</p>
+                      <p className="mt-2 font-semibold">{t(`statuses.${row.status}`)}</p>
+                      <p className="mt-1 text-xs">
+                        {t('requested_at')}: {date(row.requested_at)}
+                      </p>
+                      {row.reviewed_at ? (
+                        <p className="mt-1 text-xs">
+                          {t('reviewed_at')}: {date(row.reviewed_at)}
+                        </p>
+                      ) : null}
+                      {row.review_reason ? (
+                        <p className="mt-2 whitespace-pre-wrap break-words">
+                          <span className="font-semibold">{t('review_reason')}: </span>
+                          {row.review_reason}
+                        </p>
+                      ) : null}
+                    </div>
+                    {row.status !== 'cancelled' ? (
+                      <button
+                        type="button"
+                        className={button + ' shrink-0'}
+                        disabled={busy || mustReload}
+                        onClick={() => choose(row)}
+                      >
+                        {t('admin.review')}
+                      </button>
+                    ) : null}
+                  </div>
+                </li>
+              ))}
+            </ul>
+          )}
+          <div className="flex flex-wrap gap-3">
+            <button
+              type="button"
+              className={button}
+              disabled={busy || offset === 0}
+              onClick={() => setOffset(value => Math.max(0, value - 50))}
+            >
+              {t('admin.previous')}
+            </button>
+            <button
+              type="button"
+              className={button}
+              disabled={busy || offset + 50 >= page.total}
+              onClick={() => setOffset(value => value + 50)}
+            >
+              {t('admin.next')}
+            </button>
+          </div>
+        </>
+      ) : null}
+      {selected ? (
+        <form
+          className="min-w-0 space-y-3 rounded-xl border border-amber-200 bg-amber-50 p-4"
+          aria-label={t('admin.review')}
+          onSubmit={event => {
+            event.preventDefault()
+            void save()
+          }}
+        >
+          <h3 ref={reviewHeading} tabIndex={-1} className="break-all font-bold">
+            {t('admin.review')}: {selected.email}
+          </h3>
+          <p className="text-sm">{t('admin.reason_visible')}</p>
+          <label htmlFor={`${id}-status`} className="block text-sm font-semibold">
+            {t('admin.decision')}
+          </label>
+          <select
+            id={`${id}-status`}
+            className={input}
+            value={status}
+            disabled={busy || mustReload}
+            onChange={event => setStatus(event.target.value as typeof status)}
+          >
+            <option value="reviewed">{t('statuses.reviewed')}</option>
+            <option value="retention_hold">{t('statuses.retention_hold')}</option>
+          </select>
+          <label htmlFor={`${id}-reason`} className="block text-sm font-semibold">
+            {t('admin.reason')}
+          </label>
+          <textarea
+            id={`${id}-reason`}
+            className={input}
+            rows={4}
+            required
+            maxLength={1000}
+            value={reason}
+            disabled={busy || mustReload}
+            onChange={event => setReason(event.target.value)}
+          />
+          <div className="flex flex-wrap gap-3">
+            <button
+              type="submit"
+              className={button}
+              disabled={busy || mustReload || !reason.trim() || reason.trim().length > 1000}
+            >
+              {busy ? t('saving') : t('admin.save')}
+            </button>
+            <button
+              type="button"
+              className={button}
+              disabled={busy}
+              onClick={() => setSelected(null)}
+            >
+              {t('admin.close')}
+            </button>
+          </div>
+        </form>
+      ) : null}
+    </section>
+  )
+}
