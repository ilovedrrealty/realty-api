diff --git a/apps/dashboard/src/components/AccountDeletionRequest.tsx b/apps/dashboard/src/components/AccountDeletionRequest.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..591b8199edc3b606d3cb86b54f17e86de8226217
--- /dev/null
+++ b/apps/dashboard/src/components/AccountDeletionRequest.tsx
@@ -0,0 +1,192 @@
+import { useEffect, useId, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import {
+  AccountDeletionError,
+  cancelAccountDeletion,
+  getAccountDeletionRequest,
+  requestAccountDeletion,
+  type DeletionRequest,
+} from '../api/accountDeletion'
+
+const button = 'rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-700 disabled:cursor-not-allowed disabled:opacity-50'
+
+export function AccountDeletionRequest({ accountEmail }: { accountEmail: string }) {
+  const { t, i18n } = useTranslation('account_deletion')
+  const id = useId()
+  const [state, setState] = useState<DeletionRequest | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [refresh, setRefresh] = useState(0)
+  const [error, setError] = useState('')
+  const [email, setEmail] = useState('')
+  const [confirmed, setConfirmed] = useState(false)
+  const [busy, setBusy] = useState(false)
+  const [mustReload, setMustReload] = useState(false)
+  const mutation = useRef(false)
+
+  useEffect(() => {
+    const controller = new AbortController()
+    setLoading(true)
+    setError('')
+    setState(null)
+    setConfirmed(false)
+    setEmail('')
+    getAccountDeletionRequest(controller.signal)
+      .then(next => {
+        if (!controller.signal.aborted) {
+          setState(next)
+          setMustReload(false)
+        }
+      })
+      .catch(() => {
+        if (!controller.signal.aborted) setError('load_error')
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setLoading(false)
+      })
+    return () => controller.abort()
+  }, [accountEmail, refresh])
+
+  const active = state !== null && state.status !== 'none' && state.status !== 'cancelled'
+  const matchesEmail = email.trim().toLowerCase() === accountEmail.trim().toLowerCase()
+
+  async function submit(action: 'request' | 'cancel') {
+    if (mutation.current || loading || mustReload || !state) return
+    if (action === 'request' && (active || !matchesEmail || !confirmed)) return
+    if (action === 'cancel' && (!active || !state.request_id)) return
+
+    mutation.current = true
+    setBusy(true)
+    setError('')
+    try {
+      let next: DeletionRequest
+      if (action === 'request') {
+        next = await requestAccountDeletion(email)
+      } else {
+        next = await cancelAccountDeletion(state.request_id!, state.version)
+      }
+      setState(next)
+      setEmail('')
+      setConfirmed(false)
+    } catch (failure) {
+      const code = failure instanceof AccountDeletionError ? failure.code : 'unconfirmed'
+      if (code === 'invalid') setError('invalid')
+      else if (code === 'stale') setError('stale')
+      else setError('unconfirmed')
+      setMustReload(true)
+    } finally {
+      mutation.current = false
+      setBusy(false)
+    }
+  }
+
+  const date = (value: string) => new Date(value).toLocaleString(
+    i18n.language.startsWith('es') ? 'es-DO' : 'en-US',
+  )
+
+  return (
+    <section
+      aria-labelledby={`${id}-title`}
+      className="min-w-0 rounded-xl border border-red-200 bg-red-50/50 p-4"
+    >
+      <h3 id={`${id}-title`} className="text-sm font-bold text-red-800">
+        {t('own.title')}
+      </h3>
+      <p className="mt-2 text-sm leading-relaxed text-ink2">{t('own.intro')}</p>
+      {loading ? (
+        <p role="status" className="mt-3 text-sm">{t('loading')}</p>
+      ) : null}
+      {error ? (
+        <p role="alert" className="mt-3 text-sm font-semibold text-red-800">{t(error)}</p>
+      ) : null}
+      {state && !loading ? (
+        <div className="mt-4 space-y-3" aria-live="polite">
+          <p className="text-sm font-semibold">
+            {t('status_label')}: {t(`statuses.${state.status}`)}
+          </p>
+          {state.requested_at ? (
+            <p className="text-xs text-ink2">
+              {t('requested_at')}: {date(state.requested_at)}
+            </p>
+          ) : null}
+          {state.reviewed_at ? (
+            <p className="text-xs text-ink2">
+              {t('reviewed_at')}: {date(state.reviewed_at)}
+            </p>
+          ) : null}
+          {state.review_reason ? (
+            <div className="break-words rounded-lg border border-line bg-white p-3 text-sm">
+              <p className="font-semibold">{t('review_reason')}</p>
+              <p className="mt-1 whitespace-pre-wrap">{state.review_reason}</p>
+            </div>
+          ) : null}
+          {active ? (
+            <div className="space-y-3">
+              <p className="text-sm text-ink2">{t('own.pending')}</p>
+              <button
+                type="button"
+                className={button}
+                disabled={busy || mustReload}
+                onClick={() => void submit('cancel')}
+              >
+                {busy ? t('saving') : t('own.cancel')}
+              </button>
+            </div>
+          ) : (
+            <form
+              className="space-y-3"
+              onSubmit={event => {
+                event.preventDefault()
+                void submit('request')
+              }}
+            >
+              <label className="block text-sm font-semibold" htmlFor={`${id}-email`}>
+                {t('own.email_label')}
+              </label>
+              <input
+                id={`${id}-email`}
+                type="email"
+                autoComplete="email"
+                required
+                maxLength={320}
+                value={email}
+                disabled={busy || mustReload}
+                onChange={event => setEmail(event.target.value)}
+                className="w-full min-w-0 rounded-lg border border-red-200 bg-white px-3 py-2 text-sm"
+              />
+              <label
+                className="flex items-start gap-2 text-sm leading-relaxed"
+                htmlFor={`${id}-confirm`}
+              >
+                <input
+                  id={`${id}-confirm`}
+                  type="checkbox"
+                  required
+                  checked={confirmed}
+                  disabled={busy || mustReload}
+                  onChange={event => setConfirmed(event.target.checked)}
+                  className="mt-1 shrink-0"
+                />
+                <span>{t('own.confirm')}</span>
+              </label>
+              <button
+                type="submit"
+                className={button}
+                disabled={busy || mustReload || !matchesEmail || !confirmed}
+              >
+                {busy ? t('saving') : t('own.request')}
+              </button>
+            </form>
+          )}
+        </div>
+      ) : null}
+      <button
+        type="button"
+        className="mt-4 text-sm font-semibold text-red-800 underline disabled:opacity-50"
+        disabled={loading || busy}
+        onClick={() => setRefresh(value => value + 1)}
+      >
+        {t('refresh')}
+      </button>
+    </section>
+  )
+}
