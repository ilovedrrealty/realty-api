# Copy to `.env` (git-ignored) for local dev. In production these are set as Railway service variables.
# Every variable below is read by config.py (pydantic-settings, case-insensitive names).
# Placeholders only — real values are shared out-of-band, never committed.
# Full reference: realty/docs/ENV.md

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED (app will not start without it).
# Local dev: a local Postgres instance.
# Production: the Supabase Postgres connection string (not a Railway Postgres plugin).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ilovedrrealty

# ── Supabase (image / PDF storage only — NOT used for auth or the DB client) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
STORAGE_BUCKET=listing-images

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Signs the app's own HS256 session JWT (cookie `ildr_token`, 24 h).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-char-hex-string

# Cookie domain — leave blank for localhost; set .ilovedrrealty.com in production
# so the cookie is shared between ilovedrrealty.com and app.ilovedrrealty.com
COOKIE_DOMAIN=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# If RESEND_API_KEY is empty, emails are not sent (the log shows "[DEV] Email to ..." and, for signup, the verification code).
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@ilovedrrealty.com

# Logo URL used in email templates — set to CDN URL; falls back to LANDING_URL/iLoveDRRealty_White.png
LOGO_URL=

# Inbox that receives new-lead and payout-failure alerts.
# An admin can override the lead-alert address at runtime (Admin > Settings, stored in the `settings` table).
NOTIFY_EMAIL=

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no "*", app refuses to start with it)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Landing app base URL (used in every email link and in GHL notes)
LANDING_URL=http://localhost:3000

# ── GoHighLevel CRM (two-way lead sync) ──────────────────────────────────────
# GHL_ENABLED=false (default) disables outbound sync entirely.
GHL_ENABLED=false
GHL_API_KEY=
GHL_LOCATION_ID=
# Shared secret for inbound POST /webhooks/ghl (HMAC header or ?key= query param).
# If empty, ALL inbound GHL webhooks are rejected.
GHL_WEBHOOK_SECRET=

# ── PayPal (rental bookings: authorize -> capture -> payout) ──────────────────
# sandbox | live. Client ID/secret must belong to an app in the matching mode.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered in the PayPal developer dashboard for POST /webhooks/paypal.
# If empty, ALL inbound PayPal webhooks are rejected.
PAYPAL_WEBHOOK_ID=
# Platform cut taken before owner payout, as a fraction (0.20 = 20%)
PLATFORM_FEE_PCT=0.20

# ── Runtime ──────────────────────────────────────────────────────────────────
# `production` turns on Secure + SameSite=None cookies and the HSTS header.
ENVIRONMENT=development
# Defined in config.py but not used by the code: uvicorn reads $PORT directly
# (Railway injects it; the container falls back to 8000).
PORT=8000

# Durable delivery for newly accepted leads only. False preserves legacy dispatch.
# Enable after additive migrations and worker preflight, then verify its heartbeat.
LEAD_DELIVERY_ENABLED=false

# Enable after the updated property form is verified on both frontend aliases.
# During the backend-first rollout, only the existing email-bearing untracked
# form may use its legacy contact contract; phone-only inquiries need consent.
PROPERTY_INQUIRY_REQUIRE_CONSENT=false
